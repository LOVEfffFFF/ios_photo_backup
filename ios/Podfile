# iOS Flutter App - Photo Backup
#
# 目标设备: iPhone 14 Pro Max, iOS 17.7.2

platform :ios, '17.0'

# 加载 Flutter 的 Pod 辅助方法
flutter_application_path = File.dirname(File.realpath(__FILE__))
load File.join(flutter_application_path, 'Flutter', 'flutter_export_environment.sh') rescue nil

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['ARCHS'] = 'arm64'
      config.build_settings['VALID_ARCHS'] = 'arm64'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
    end
  end
end
